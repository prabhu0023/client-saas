# ============================================================
# Supabase (Project Settings -> API)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. Bypasses RLS; used ONLY server-side for the
# WhatsApp/booking path where the patient is not a logged-in user.
# Keep secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Reminder cron
# ============================================================
# Shared secret protecting GET /api/cron/reminders. The external
# scheduler must send it as the `x-cron-secret` header. Generate:
#   openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# ============================================================
# WhatsApp channel (via wacrm) — one wacrm ACCOUNT per clinic
# ============================================================
# Base URL of the wacrm instance and a public-API key (Bearer token).
# The key needs scopes: messages:send (send replies) and contacts:read
# (resolve a contact's phone). The clinic app calls wacrm to send
# booking prompts/confirmations.
WACRM_BASE_URL=https://your-wacrm-instance.example.com
WACRM_API_KEY=wacrm_live_your-api-key

# Signing secret for wacrm's outbound webhook, returned once when you
# register the endpoint (POST /api/v1/webhooks) subscribed to
# 'message.received'. Inbound deliveries are HMAC-signed with this;
# /api/whatsapp/inbound verifies X-Wacrm-Signature against it.
WACRM_WEBHOOK_SECRET=whsec_your-webhook-secret

# The wacrm account_id -> clinic mapping lives in the DB table
# clinic_wacrm_accounts (see migration 007_clinic_wacrm_accounts.sql).
# An admin writes it from /setup -> Connect WhatsApp; no env var needed
# since one clinic maps to exactly one wacrm account.

# ============================================================
# Self-serve onboarding (/signup, /onboarding, invites)
# ============================================================
# Gate on /signup. SET = anyone with the code may create a clinic;
# UNSET = the form is open on a local dev server only and disabled
# everywhere else (it fails closed, and never reads VERCEL_ENV).
# Generate:
#   openssl rand -hex 16
ONBOARDING_SIGNUP_CODE=generate-a-random-string

# Public base URL of this deployment, used to build invite links
# (<base>/join/<token>). Creating an invite THROWS while this is unset,
# before any token is issued — so set it before inviting staff.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# DB-backed test suites (optional; they skip when unset)
# ============================================================
# A THROWAWAY Supabase/Postgres project — these suites write and delete
# real rows. Never point them at production.
#   TEST_DATABASE_URL         project URL (https://xxx.supabase.co)
#   TEST_DATABASE_SERVICE_KEY service-role key, for fixtures + teardown
#   TEST_DATABASE_ANON_KEY    anon key, for the RLS rejection cases
TEST_DATABASE_URL=
TEST_DATABASE_SERVICE_KEY=
TEST_DATABASE_ANON_KEY=
