# ============================================================
# Supabase (Project Settings -> API)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. Bypasses RLS; used ONLY server-side for the
# WhatsApp/booking path where the patient is not a logged-in user.
# Keep secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Reminder cron
# ============================================================
# Shared secret protecting GET /api/cron/reminders. The external
# scheduler must send it as the `x-cron-secret` header. Generate:
#   openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# ============================================================
# WhatsApp channel (via wacrm for MVP)
# ============================================================
# Base URL of the wacrm instance used as the messaging channel, and
# an API key for its public API. The clinic app calls this to send
# templates / interactive messages.
WACRM_BASE_URL=https://your-wacrm-instance.example.com
WACRM_API_KEY=your-wacrm-api-key
